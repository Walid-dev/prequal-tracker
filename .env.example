# Copy this file to .env.local for local development. Never commit .env.local.

# mock: stored answers, no API key, no cost (default).
# live: calls Claude through the AI SDK.
AI_MODE=mock

# Required when AI_MODE=live.
ANTHROPIC_API_KEY=

# The eval picks the default model (see docs/decisions.md). Until then: claude-opus-5.
AI_MODEL=claude-opus-5

# SQLite file path. Docker uses /data/app.db.
DATABASE_PATH=./data/app.db
