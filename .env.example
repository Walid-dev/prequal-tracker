# Copy this file to .env.local for local development. Never commit .env.local.

# mock: stored answers, no API key, no cost (default).
# live: calls the model set in AI_MODEL.
AI_MODE=mock

# The model, as provider:model. This one setting switches the model and the provider.
# Examples: anthropic:claude-sonnet-5 (default, chosen from the eval), anthropic:claude-haiku-4-5, openai:gpt-6-sol
AI_MODEL=anthropic:claude-sonnet-5

# The key for the provider in AI_MODEL. Only that one is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# SQLite file path. Docker uses /data/app.db.
DATABASE_PATH=./data/app.db

# true: add the two demo cases at server start when the database has no cases.
# Locally you can also run `npm run seed`. Docker turns this on by default.
SEED_DEMO_DATA=false
